@model IEnumerable<ToyStore2.Models.Toy>

@{
    ViewData["Title"] = "Каталог игрушек";
}

<div class="container py-4">
    <h2 class="my-4 text-center fw-bold" style="color: #0d6efd;">Наш магазин игрушек</h2>
    <p class="text-center text-muted mb-5">Выберите лучший подарок для вашего ребенка</p>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                    <!-- Картинка с фиксированной высотой -->
                    <img src="@item.ImageUrl" class="card-img-top p-3" alt="@item.Name" style="height: 220px; object-fit: contain; background-color: #f8f9fa;">

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@item.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@item.Description</p>

                        <!-- Цена и кнопка -->
                        <div class="mt-auto">
                            <span class="badge bg-success mb-3 p-2 fs-6 rounded-pill">
                                @item.Price.ToString("C")
                            </span>

                            @{
                                var request = ViewContext.HttpContext.Request;
                                var returnUrl = request.Path + request.QueryString.ToUriComponent();
                            }
                            <a asp-action="Add" asp-controller="Cart" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl" class="btn btn-primary w-100 fw-bold">
                                <i class="fas fa-shopping-cart me-2"></i> В корзину
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>